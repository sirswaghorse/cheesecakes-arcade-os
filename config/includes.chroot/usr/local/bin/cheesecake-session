#!/bin/sh

mkdir -p /home/arcade/.config/cheesecake

ARCADE_URL="https://cheesecakesarcade.lovable.app/tv"

exec /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --ozone-platform=wayland \
  --no-sandbox \
  --disable-gpu-sandbox \
  --disable-dev-shm-usage \
  --ignore-gpu-blocklist \
  --autoplay-policy=no-user-gesture-required \
  --user-data-dir=/home/arcade/.config/cheesecake \
  "$ARCADE_URL"
