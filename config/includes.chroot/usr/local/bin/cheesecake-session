#!/bin/sh
set -e

mkdir -p /home/arcade/.config/cheesecake

ARCADE_URL="https://cheesecakesarcade.lovable.app/tv"

exec /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --enable-features=UseOzonePlatform \
  --ozone-platform=wayland \
  --test-type \
  --in-process-gpu \
  --autoplay-policy=no-user-gesture-required \
  --user-data-dir=/home/arcade/.config/cheesecake \
  "$ARCADE_URL"
