[Unit]
Description=Cheesecakes Arcade console session
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=arcade
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=+/bin/sh -c 'mkdir -p /run/user/1000 && chown arcade:arcade /run/user/1000'
ExecStart=/usr/local/bin/cheesecake-session
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
