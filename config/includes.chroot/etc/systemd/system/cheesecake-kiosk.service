[Unit]
Description=Cheesecakes Arcade console session
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
User=arcade
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
ExecStartPre=+/bin/sh -c 'mkdir -p /run/user/1000 && chown arcade:arcade /run/user/1000'
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/cheesecake-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target

