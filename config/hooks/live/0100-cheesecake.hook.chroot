#!/bin/sh
set -e

# Create arcade user with standard bash shell and hardware groups
id arcade >/dev/null 2>&1 || useradd -m -u 1000 -G audio,video,input,render,bluetooth,netdev,tty -s /bin/bash arcade
passwd -d arcade >/dev/null 2>&1 || true

# Let arcade run the installer (and reboot) without a password
cat <<'EOF' > /etc/sudoers.d/cheesecake-installer
arcade ALL=(root) NOPASSWD: /usr/local/bin/cheesecake-installer, /sbin/reboot
EOF
chmod 440 /etc/sudoers.d/cheesecake-installer

echo "cheesecake-os" > /etc/hostname
plymouth-set-default-theme cheesecake
update-initramfs -u

systemctl enable NetworkManager bluetooth
systemctl set-default graphical.target

# Ensure session scripts are executable
chmod +x /usr/local/bin/cheesecake-session 2>/dev/null || true
chmod +x /usr/local/bin/cheesecake-installer 2>/dev/null || true

# Configure automatic login on TTY1 for the arcade user
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat <<'EOF' > /etc/systemd/system/getty@tty1.service.d/override.conf
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin arcade --noclear %I $TERM
Type=idle
EOF

# Ensure user arcade owns their home directory and profile
chown -R arcade:arcade /home/arcade

# Enable TTY2 for debugging during preview/testing
systemctl enable getty@tty2.service || true
